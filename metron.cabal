cabal-version:   3.12
name:            metron
version:         0.1.0.0
synopsis:        A pure, unit-aware, content-addressed calculator language
description:     A calculator language with SI dimensions, tensors, coordinate
                 charts, Monte Carlo sampling, independent rounding diagnostics,
                 and content-addressed definitions.
homepage:        https://github.com/bflyblue/metron
bug-reports:     https://github.com/bflyblue/metron/issues
license:         MIT
license-file:    LICENSE
author:          Shaun Sharples
maintainer:      shaun.sharples@gmail.com
-- copyright:
category:        Language
build-type:      Simple
extra-source-files: cbits/limits.c
extra-doc-files: CHANGELOG.md README.md TUTORIAL.md doc/core.md doc/design.md doc/style.md doc/overview.md doc/montecarlo-first.md doc/montecarlo-removal-plan.md

source-repository head
  type:          git
  location:      https://github.com/bflyblue/metron.git

common common
  ghc-options:        -Wall
  default-language:   GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import:          common
  hs-source-dirs:  lib
  exposed-modules:
    , Metron.Command
    , Metron.Edit
    , Metron.Session.Preferences
    , Metron.Compile
    , Metron.Source
    , Metron.Session.Names
    , Metron.Session.Types
    , Metron.Check
    , Metron.Type.Syntax
    , Metron.NameResolution
    , Metron.Resolve.Error
    , Metron.UnitHint
    , Metron.Numerical.Approx
    , Metron.Numerical.Error
    , Metron.Numerical.Identity
    , Metron.Numerical.Rational
    , Metron.Numerical.Sampling
    , Metron.Numerical.SamplePlan
    , Metron.Numerical.Statistics
    , Metron.Type.Match
    , Metron.Primitive.Types
    , Metron.Primitive
    , Metron.Batch
    , Metron.Branch
    , Metron.Builtin
    , Metron.Codebase
    , Metron.Core
    , Metron.Desugar
    , Metron.Fixity
    , Metron.Dimension
    , Metron.Double
    , Metron.Rational
    , Metron.Encode
    , Metron.Driver
    , Metron.Eval
    , Metron.Hash
    , Metron.Infer
    , Metron.Lexer
    , Metron.Limits
    , Metron.Needs
    , Metron.Parser
    , Metron.Prelude
    , Metron.Pretty
    , Metron.Remark
    , Metron.Repl
    , Metron.Scalar
    , Metron.Resolve
    , Metron.Store
    , Metron.Strictness
    , Metron.Syntax
    , Metron.TCore
    , Metron.Type
    , Metron.Type.Base
    , Metron.Unicode
    , Metron.Update
  c-sources:       cbits/limits.c
  build-depends:
    , async
    , base ^>=4.21.0.0
    , bytestring
    , containers
    , cryptohash-sha256
    , directory
    , filepath
    , megaparsec
    , mtl
    , parser-combinators
    , text
    , time
    , transformers
    , unicode-transforms
    , vector

executable metron
  import:         common
  main-is:        Main.hs
  hs-source-dirs: src
  ghc-options:    -threaded -feager-blackholing -rtsopts "-with-rtsopts=-qg1 -qn4"
  build-depends:
    , base ^>=4.21.0.0
    , directory
    , metron
    , filepath
    , haskeline
    , process
    , text

test-suite metron-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -rtsopts "-with-rtsopts=-T"
  build-tool-depends: metron:metron
  other-modules:
    , Backend
    , Astro
    , Gen
    , Lang.Charts
    , Lang.Codebase
    , Lang.Common
    , Lang.Core
    , Lang.Data
    , Lang.EndToEnd
    , Lang.Frames
    , Lang.Library
    , Lang.Properties
    , Lang.Repl
    , Lang.Store
    , Lang.Syntax
    , Lang.Tensors
    , Lang.Types
    , Lang.Units
    , Limits
    , Operators
    , Precision
    , Review
    , Sampling
    , Support.ExactApprox
    , Support.References
    , Support.Render
    , Traversal
  build-depends:
    , base ^>=4.21.0.0
    , bytestring
    , containers
    , metron
    , directory
    , filepath
    , process
    , QuickCheck
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time
    , vector

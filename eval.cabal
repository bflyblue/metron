cabal-version:   3.12
name:            eval
version:         0.1.0.0
synopsis:        A pure, unit-aware, content-addressed calculator language
-- description:
license:
author:          Shaun Sharples
maintainer:      shaun.sharples@gmail.com
-- copyright:
category:        Language
build-type:      Simple
extra-doc-files: CHANGELOG.md

common common
  ghc-options:        -Wall
  default-language:   GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import:          common
  hs-source-dirs:  lib
  exposed-modules:
    , Eval.Affine
    , Eval.Command
    , Eval.Edit
    , Eval.Session.Preferences
    , Eval.Compile
    , Eval.Source
    , Eval.Session.Names
    , Eval.Session.Types
    , Eval.Check
    , Eval.Type.Syntax
    , Eval.NameResolution
    , Eval.Resolve.Error
    , Eval.UnitHint
    , Eval.Numerical.Linear
    , Eval.Numerical.Approx
    , Eval.Type.Match
    , Eval.Primitive.Types
    , Eval.Primitive
    , Eval.Builtin
    , Eval.Codebase
    , Eval.Core
    , Eval.Desugar
    , Eval.Dimension
    , Eval.Encode
    , Eval.Driver
    , Eval.Eval
    , Eval.Hash
    , Eval.Infer
    , Eval.Lexer
    , Eval.Parser
    , Eval.Prelude
    , Eval.Pretty
    , Eval.Repl
    , Eval.Resolve
    , Eval.Store
    , Eval.Syntax
    , Eval.TCore
    , Eval.Type
    , Eval.Type.Base
    , Eval.Unicode
    , Eval.Update
  build-depends:
    , base ^>=4.21.0.0
    , bytestring
    , containers
    , cryptohash-sha256
    , directory
    , filepath
    , megaparsec
    , mtl
    , parser-combinators
    , text
    , time
    , transformers
    , unicode-transforms
    , vector

executable eval
  import:         common
  main-is:        Main.hs
  hs-source-dirs: src
  ghc-options:    -O -threaded -feager-blackholing
  build-depends:
    , base ^>=4.21.0.0
    , directory
    , eval
    , filepath
    , haskeline
    , process
    , text

test-suite eval-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:
    , Gen
    , Support.Render
  build-depends:
    , base ^>=4.21.0.0
    , bytestring
    , containers
    , eval
    , directory
    , filepath
    , QuickCheck
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time
    , vector
